<% if(currentUser){%>
<aside class="sidebar">
  <nav class="side-nav">
    <ul class="nav-list">

      <!-- User profile -->
      <li class="nav-item">
        <a href="/" class="nav-link user">
          <div class="profile">
            <i class="mi">person</i>
          </div>
          <span class="username" style="color: white">
            <%= currentUser?.username || "User" %>
          </span>
        </a>
      </li>

      <!-- Create Message -->
      <li class="nav-item <%= page === 'inbox' ? 'active' : '' %>">
        <a href="/" class="nav-link">
          <i class="mi">inbox</i>
          <span>Inbox</span>
        </a>
      </li>

      <!-- Clubs -->
      <li class="nav-item <%= page === 'clubs' ? 'active' : '' %>">
        <a href="/clubs" class="nav-link">
          <i class="mi">groups</i>
          <span>Clubs</span>
        </a>
      </li>

      <!-- Logout -->
      <li class="nav-item logout">
        <a href="/logout" class="nav-link">
          <i class="mi">logout</i>
          <span>Logout</span>
        </a>
      </li>

    </ul>
  </nav>
</aside>
<%}%>