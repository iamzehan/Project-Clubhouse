<div class="sub-content">
  <h1 class="title"><%= title %></h1>

  <% if (clubs.length === 0) { %>
    <p style="color: #777" class="no-clubs">
      There are no other clubs <i class="mi">heart_broken</i>
    </p>
  <% } else { %>
    <div class="clubs-grid">
      <% clubs.forEach(club => { %>
        <a href="/clubs/<%= club.id %>">
          <div class="club-card">
            <% if (club.image_url) { %>
              <img src="<%= club.image_url %>" alt="<%= club.name %> image" />
            <% } else { %>
              <img src="/images/default-club.png" alt="Default club image" />
            <% } %>

            <div class="club-info">
              <span class="club-name"><%= club.name %></span>
              <button class="primary light join-btn" data-club-id="<%= club.id %>">
                Join <i class="mi">add</i>
              </button>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
  // Handle Join button click separately
  document.querySelectorAll(".join-btn").forEach(btn => {
    btn.addEventListener("click", function(e) {
      e.preventDefault();      // prevent default button behavior
      e.stopPropagation();     // prevent outer <a> click
      const clubId = this.dataset.clubId;
      window.location.href = `/clubs/join/${clubId}`; // navigate to join page
    });
  });
</script>
