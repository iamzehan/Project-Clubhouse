<ul class="post-menu-list cards-vibe" id="list-<%=post_id%>">
  <a href="/clubs/<%=club_id%>/post/edit/<%=post_id%>">Edit</li></a>
  <li>
    <form action="/clubs/post/delete" method="POST" class="delete-form">
        <input type="hidden" name="_csrf" value="<%=csrfToken%>" />
      <input type="hidden" name="club_id" value="<%=club_id%>" />
      <input type="hidden" name="post_id" value="<%=post_id%>" />
      <button type="submit">Delete</button>
    </form>
  </li>
</ul>
<script>
  const deleteForm = document.querySelector(".delete-form");
  deleteForm.addEventListener("submit", (e)=> {
    e.preventDefault();
    const dlt = confirm("Are you sure you want to delete?");
    if(dlt){
      e.target.submit();
    }
  })
</script>

